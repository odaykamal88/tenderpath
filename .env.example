# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
JWT_SECRET=your-jwt-secret-min-32-chars

# Google OAuth — powers "Continue with Google" on /login
# Create an OAuth 2.0 Client ID (type: Web application) under
#   https://console.cloud.google.com/apis/credentials
# Paste the literal credential VALUES below — NOT the setup command. (Prod once
# had `npx vercel env add ...` pasted into GOOGLE_CLIENT_ID, which Google
# rejected with "Access blocked: Authorization Error".)
# In that client's "Authorized redirect URIs", register EXACTLY (no trailing slash):
#   https://www.tenderpath.me/api/auth/google/callback   <- prod (www is canonical; apex 307s to www)
#   http://localhost:3000/api/auth/google/callback        <- local dev
# The redirect URI is built from NEXT_PUBLIC_APP_URL (see "# App" below) + /api/auth/google/callback.
# Leave both unset locally to fall back to the magic-link / password sign-in paths.
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TENDER_INTELLIGENCE=price_...
STRIPE_PRICE_SUBMISSION_PACKAGE=price_...
STRIPE_PRICE_STRATEGIC_PARTNERSHIP=price_...

# Anthropic (assessment AI; also used as external prospect web-search fallback)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_WEB_SEARCH_MODEL=claude-haiku-4-5-20251001

# OpenAI (optional: bot natural-language answers + preferred admin external prospect discovery)
OPENAI_API_KEY=sk-proj-...
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
# Model for the no-web "procurement brief" pass (defaults to OPENAI_WEB_SEARCH_MODEL).
OPENAI_DISCOVERY_BRIEF_MODEL=gpt-4.1-mini
# Web-search context size for prospect discovery: low | medium | high (default medium).
OPENAI_WEB_SEARCH_CONTEXT=medium

# Crawler worker for Cloudflare/JS-rendered procurement sources
CRAWLER_WORKER_URL=https://your-crawler-worker.workers.dev/fetch
CRAWLER_WORKER_KEY=your-crawler-worker-secret

# Email (Resend)
RESEND_API_KEY=re_...

# Cron Security
CRON_SECRET=your-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Alternative Payments ─────────────────────────────────────────────────────

